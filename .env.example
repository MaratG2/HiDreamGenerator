# HiDream-O1-Image checkpoint (required if --model_path is not passed)
HIDREAM_MODEL_PATH=HiDream-ai/HiDream-O1-Image-SDNQ-4bit-low-vram
HIDREAM_MODEL_TYPE=full
HIDREAM_ATTENTION_BACKEND=auto
HIDREAM_MOCK_MODE=0
FA_VERSION=2
SDNQ_USE_TORCH_COMPILE=1
SDNQ_USE_TRITON_MM=1

# Flask host / port
HIDREAM_HOST=127.0.0.1
HIDREAM_PORT=7860

# Lightweight MCP adapter (the image server still runs separately)
HIDREAM_API_URL=http://127.0.0.1:7860
HIDREAM_MCP_OUTPUT_DIR=results/mcp

# Prompt-refiner defaults used by app.py
HIDREAM_REFINE_BASE_URL=http://localhost:8000/v1
HIDREAM_REFINE_MODEL=HiDream-ai/Prompt-Refine

# Prompt-refiner vLLM launcher settings (export these before launching)
HIDREAM_REFINER_MODEL=HiDream-ai/Prompt-Refine
HIDREAM_REFINER_SERVED_NAME=HiDream-ai/Prompt-Refine
HIDREAM_REFINER_HOST=127.0.0.1
HIDREAM_REFINER_PORT=8000
HIDREAM_REFINER_MAX_MODEL_LEN=8192
HIDREAM_REFINER_TENSOR_PARALLEL_SIZE=1

# Native Windows llama.cpp launcher (recommended for a 16 GiB GPU)
HIDREAM_REFINER_GGUF=HiDream-ai/Prompt-Refine-GGUF/Prompt-Refine-Q4_K_M.gguf

# Only add trusted deployment hosts/origins when configuring an authenticated proxy.
HIDREAM_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
HIDREAM_ALLOWED_ORIGINS=
HIDREAM_REFINE_TIMEOUT=120
HIDREAM_REFINE_API_KEY=EMPTY
